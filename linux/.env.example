SGCC_BIND_ADDRESS=127.0.0.1
SGCC_PORT=8765
SGCC_UID=1000
SGCC_GID=1000
SGCC_BROWSER_EXECUTABLE=
SGCC_BROWSER_PROXY=
SGCC_ADMIN_TOKEN=replace-with-a-long-random-token
SGCC_TIMEZONE=Asia/Shanghai
SGCC_SCAN_ENABLED=true
SGCC_SCAN_CRON=0 3 * * *
SGCC_SCAN_ON_START=false
SGCC_DOWNLOAD_AFTER_SCAN=true
SGCC_DOWNLOAD_WORKERS=4
SGCC_REQUEST_TIMEOUT_SECONDS=90
SGCC_NAVIGATION_TIMEOUT_SECONDS=60
SGCC_SCAN_REQUEST_TIMEOUT_SECONDS=15
SGCC_PROVINCE_SCAN_TIMEOUT_SECONDS=45
SGCC_MAX_REGION_CANDIDATES=12
SGCC_MAX_DOWNLOAD_MB=200
